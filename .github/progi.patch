+      const rr=await fetch(rawUrl,{cache:'no-store'});
+      if(!rr.ok)throw new Error('Plik bazy jest duży (> 1 MB) i GitHub nie zwrócił treści; surowy odczyt: HTTP '+rr.status);
+      return {sha:j.sha,doc:await rr.json()};
+    }
